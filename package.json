{
  "name": "nmc-rate-desk",
  "productName": "NMC Rate Desk",
  "version": "1.3.0",
  "description": "Neighborhood Mortgage Company rate desk — publishes par rates by credit tier for the NMC Toolkit",
  "author": "Neighborhood Mortgage Company",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.neighborhoodmc.ratedesk",
    "productName": "NMC Rate Desk",
    "copyright": "© Neighborhood Mortgage Company",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "NMC-Rate-Desk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NMC Rate Desk"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "NMC-Rate-Desk-${version}.${ext}"
    },
    "dmg": { "artifactName": "NMC-Rate-Desk-${version}.${ext}" },
    "publish": { "provider": "github", "owner": "doubledekr", "repo": "nmc-rate-desk", "releaseType": "release" }
  }
}
